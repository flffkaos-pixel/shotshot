# Vercel AI Gateway (Hobby free, BYOK when user adds key)
AI_GATEWAY_API_KEY=

# Cloudflare R2 (S3-compatible, 10GB free, egress free)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shotshot
R2_PUBLIC_URL=

# Supabase (Auth magic link + DB, 50k MAU free)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: OpenRouter fallback (1 key, 25+ free models, 5.5% fee)
OPENROUTER_API_KEY=

# PayPal (use sandbox for dev, set PAYPAL_ENV=live in prod)
# ponytail: USD default. Switch to KRW for Korean market by setting PAYPAL_CURRENCY=KRW and PRICE accordingly.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SUBSCRIPTION_PLAN_ID=P-XXXXX   # create in PayPal dashboard
PAYPAL_LIFETIME_PRICE=49.00
PAYPAL_CURRENCY=USD                  # USD or KRW
PAYPAL_WEBHOOK_ID=

# ponytail: Toss Payments (Korea local, optional, KRW only)
# Sign up at https://toss.im / enable developer dashboard
# Create billing key for "정기결제" subscription
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_BILLING_KEY=
TOSS_CUSTOMER_KEY_PREFIX=shotshot

# ponytail: Naver Pay (Korea local, optional)
# https://developer.pay.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Resend (transactional email, 100/day free)
RESEND_API_KEY=
RESEND_FROM=Shotshot <noreply@shotshot.app>
# ponytail: receives webhook failure alerts
ADMIN_EMAIL=

# Cron + admin auth (reuse CRON_SECRET for both)
CRON_SECRET=generate-a-long-random-string
ADMIN_SECRET=same-or-different-long-random-string

# Display prices for admin MRR
PRO_PRICE_USD=5
LIFETIME_PRICE_USD=49
